# ============================================
# Trading Bot 환경변수 설정 예시
# ============================================
# 사용법: 이 파일을 복사해서 .env로 저장하고 값을 수정하세요
# cp env.example .env

# ============================================
# 전략 선택 (7개 중 1개)
# ============================================
STRATEGY_SELECTOR=ensemble
# STRATEGY_SELECTOR=trend
# STRATEGY_SELECTOR=reversion
# STRATEGY_SELECTOR=breakout
# STRATEGY_SELECTOR=scalping
# STRATEGY_SELECTOR=daytrade
# STRATEGY_SELECTOR=swing

# ============================================
# 매매 모드 (3가지)
# ============================================
TRADING_MODE=backtest
# TRADING_MODE=paper
# TRADING_MODE=live

# ============================================
# 데이터베이스 (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://trading_user:trading_pw_2024@localhost:5433/trading_db

# ============================================
# Binance API (LIVE 모드 시 필수!)
# ============================================
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here

# ============================================
# 리스크 관리
# ============================================
# 자본금 (USDT)
EQUITY_USDT=10000

# 거래당 리스크 (1% = 0.01)
RISK_PER_TRADE=0.01

# 일손실 한도 (3% = 0.03)
DAILY_RISK_LIMIT_PCT=0.03
DAILY_LOSS_LIMIT_PCT=0.03

# 최대 동시 포지션
MAX_POSITIONS=5
MAX_CONCURRENT_POSITIONS=5

# ============================================
# 포지션 사이징 (동적) ⭐ 신규
# ============================================
# 품질 가중치 범위 (confidence 기반)
QUALITY_WEIGHT_MIN=0.7
QUALITY_WEIGHT_MAX=1.3

# 포지션 가치 한도
MAX_POSITION_VALUE=5000
MIN_POSITION_VALUE=10

# 심볼별 최대 노출 (자산의 30%)
MAX_EXPOSURE_PER_SYMBOL_PCT=0.3

# ============================================
# 레버리지 설정
# ============================================
MAX_LEVERAGE=10                # 최대 레버리지
MIN_LEVERAGE=2                 # 최소 레버리지
DEFAULT_LEVERAGE=5             # 기본 레버리지

# 극단적 레버리지 (고확률 신호 전용) ⭐ Phase 2
ENABLE_EXTREME_LEVERAGE=false
EXTREME_LEVERAGE_MIN=50        # 극단적 최소
EXTREME_LEVERAGE_MAX=200       # 극단적 최대
EXTREME_CONFIDENCE_MIN=0.95    # 95% 이상 확신 시만

# ============================================
# 수수료 (Binance Futures 기준)
# ============================================
MAKER_FEE=0.0002
TAKER_FEE=0.0004

# ============================================
# 기타 설정
# ============================================
# TP/SL 비율
TP1_RR=1.0
TP2_RR=2.0

# Trail Stop (TP1 달성 시 손절가 이동)
ENABLE_TP_TRAIL=true
TRAIL_AFTER_TP1=true

# Flash Guard (급등락 감지)
ENABLE_FLASH_GUARD=true
FLASH_GUARD_PCT=0.02
FLASH_GUARD_PAUSE_MIN=5
